NODE_ENV=production
PORT=3000
DATABASE_URL=
PUBLIC_URL=https://REPLACE-SERVER.up.railway.app
ALLOWED_ORIGINS=https://senyamarketing.ru,https://www.senyamarketing.ru
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
TELEGRAM_CHAT_ID=
# Independently generate each secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=
TILDA_WEBHOOK_SECRET=
RETENTION_DAYS=90
PRIVACY_POLICY_URL=
TILDA_ALLOWED_FIELDS=Name,Phone,Email,Telegram,Message
TILDA_FORM_NAMES={}
# Railway edge is the only proxy hop. Use 0 for direct local requests.
TRUST_PROXY=1
# Optional: Render generates this on the SERVER; derives separate webhook secrets.
# Explicit TELEGRAM_WEBHOOK_SECRET/TILDA_WEBHOOK_SECRET override derived secrets.
CHAT_SECRET_SEED=
# Render uses 900000; successful POST wakes delivery immediately, retries use next_at.
WORKER_IDLE_MS=1500
